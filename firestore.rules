rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSystemAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.systemRole == 'admin';
    }

    function isClubManager(clubId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/clubs/$(clubId)) &&
        request.auth.uid in get(/databases/$(database)/documents/clubs/$(clubId)).data.managerUids;
    }

    function membershipId(teamId) {
      return teamId + '_' + request.auth.uid;
    }

    function hasMembership(teamId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/staffMemberships/$(membershipId(teamId)));
    }

    function membershipData(teamId) {
      return get(/databases/$(database)/documents/staffMemberships/$(membershipId(teamId))).data;
    }

    function hasCapability(teamId, capability) {
      return hasMembership(teamId) &&
        membershipData(teamId).active == true &&
        membershipData(teamId).capabilities[capability] == true;
    }

    // Puede tocar la plantilla/convocatoria de un equipo: admin, gestor del
    // club dueño, o staff con la capacidad concreta.
    function canManageTeamCapability(clubId, teamId, capability) {
      return isSystemAdmin() || isClubManager(clubId) || hasCapability(teamId, capability);
    }

    function isActiveStaff(teamId) {
      return hasMembership(teamId) && membershipData(teamId).active == true;
    }

    // Un follow o una tutela aprobados dan acceso de lectura a todo el
    // equipo (misma decisión de producto para ambos). Id determinista
    // teamId_uid — ver followDocId/guardianshipDocId en permissions.js.
    function isApprovedForTeam(teamId) {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/follows/$(teamId + '_' + request.auth.uid)) &&
          get(/databases/$(database)/documents/follows/$(teamId + '_' + request.auth.uid)).data.status == 'approved') ||
        (exists(/databases/$(database)/documents/guardianships/$(teamId + '_' + request.auth.uid)) &&
          get(/databases/$(database)/documents/guardianships/$(teamId + '_' + request.auth.uid)).data.status == 'approved')
      );
    }

    // Puede leer los datos (plantilla/partidos) de un equipo: admin, gestor
    // del club dueño, staff activo del equipo, o Seguidor/tutor aprobado.
    // Sustituye el "cualquier usuario registrado puede leer" original.
    function canViewTeamData(clubId, teamId) {
      return isSignedIn() &&
        (isSystemAdmin() || isClubManager(clubId) || isActiveStaff(teamId) || isApprovedForTeam(teamId));
    }

    // Perfiles de usuario: el flag de administrador de sistema vive aquí.
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isSystemAdmin());

      allow create: if isSignedIn() && request.auth.uid == uid && (
        !('systemRole' in request.resource.data) || request.resource.data.systemRole == null ||
        (request.resource.data.systemRole == 'admin' && request.auth.token.email == 'aperlesc@gmail.com')
      );

      allow update: if isSignedIn() && (
        (request.auth.uid == uid && request.resource.data.systemRole == resource.data.systemRole) ||
        // Autopromoción de la cuenta propietaria: cubre cuentas que ya
        // existían antes de este modelo y se habían quedado sin systemRole.
        (request.auth.uid == uid && request.auth.token.email == 'aperlesc@gmail.com' &&
          request.resource.data.systemRole == 'admin') ||
        isSystemAdmin()
      );

      allow delete: if false;
    }

    // Sesiones de Seguidor: cuándo se conecta cada persona, qué ha visto y
    // cuánto tiempo lleva activa — para que el administrador de sistema
    // pueda verlo. Cada quien solo puede crear/actualizar su propia sesión
    // (personUid == su uid); nadie puede leer las de otras personas salvo
    // el administrador.
    match /followerSessions/{sessionId} {
      allow read: if isSystemAdmin();
      allow create: if isSignedIn() && request.resource.data.personUid == request.auth.uid;
      allow update: if isSignedIn() && resource.data.personUid == request.auth.uid &&
        request.resource.data.personUid == request.auth.uid;
      allow delete: if isSystemAdmin();
    }

    match /leagues/{leagueId} {
      allow read: if isSignedIn();
      allow write: if isSystemAdmin();
    }

    match /clubs/{clubId} {
      allow read: if isSignedIn();
      // Antes solo el Administrador de Sistema podía crear un club — 2026-09-24: un
      // gestor de club normal también puede, pero SOLO como club del que él mismo
      // queda de gestor (para fichar un rival nuevo al crear un partido, ver
      // MatchesAdmin.jsx — el "club rival" que crea es un club de verdad, con sus
      // propios equipos). No puede crear un club vacío sin gestor (eso lo sigue
      // reservando el flujo del Administrador de Sistema, con managerUids: []).
      allow create: if isSystemAdmin() ||
        (isSignedIn() && request.auth.uid in request.resource.data.managerUids);
      // Igual con actualizar: además del Administrador de Sistema, el propio gestor
      // del club ya puede corregir sus datos (antes ni eso podía).
      allow update: if isSystemAdmin() || isClubManager(clubId);
      allow delete: if isSystemAdmin();
    }

    match /teams/{teamId} {
      allow read: if isSignedIn();
      allow create: if isSystemAdmin() || isClubManager(request.resource.data.clubId);
      allow update, delete: if isSystemAdmin() || isClubManager(resource.data.clubId);

      // Versión mínima y pública de la plantilla (solo nombre y dorsal, sin
      // foto ni otros datos): permite elegir "de qué jugador/a soy familiar"
      // al pedir tutela sin necesitar ya el acceso aprobado que exige leer
      // la colección "players" completa. La escribe quien gestiona la
      // plantilla, igual que "players".
      match /rosterDirectory/{playerId} {
        allow read: if isSignedIn();
        allow create, update: if canManageTeamCapability(request.resource.data.clubId, teamId, 'manageRoster');
        allow delete: if canManageTeamCapability(resource.data.clubId, teamId, 'manageRoster');
      }
    }

    match /staffMemberships/{membershipDocId} {
      // Además de la propia persona/admin/gestor, cualquiera con acceso de
      // lectura al equipo (staff activo, o Seguidor/tutela aprobados) puede
      // ver quién es el staff — solo lectura, sigue sin poder tocar nada.
      allow read: if isSignedIn() && (
        resource.data.personUid == request.auth.uid ||
        canViewTeamData(resource.data.clubId, resource.data.teamId)
      );
      allow create: if isSystemAdmin() || isClubManager(request.resource.data.clubId);
      allow update, delete: if isSystemAdmin() || isClubManager(resource.data.clubId);
    }

    match /follows/{followDocId} {
      allow read: if isSignedIn() && (
        resource.data.personUid == request.auth.uid || isSystemAdmin() ||
        (exists(/databases/$(database)/documents/teams/$(resource.data.teamId)) &&
          isClubManager(get(/databases/$(database)/documents/teams/$(resource.data.teamId)).data.clubId))
      );
      allow create: if isSignedIn() &&
        request.resource.data.personUid == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        // Quien pide acceso no se puede asignar el nivel Pro: lo decide el
        // gestor al aprobar (update). Sin campo o 'standard' = Estándar.
        (!('tier' in request.resource.data) || request.resource.data.tier == 'standard');
      allow update: if isSignedIn() &&
        exists(/databases/$(database)/documents/teams/$(resource.data.teamId)) &&
        (isSystemAdmin() ||
          isClubManager(get(/databases/$(database)/documents/teams/$(resource.data.teamId)).data.clubId));
      allow delete: if isSignedIn() && resource.data.personUid == request.auth.uid;
    }

    match /guardianships/{guardianshipDocId} {
      allow read: if isSignedIn() && (
        resource.data.personUid == request.auth.uid || isSystemAdmin() ||
        (exists(/databases/$(database)/documents/teams/$(resource.data.teamId)) &&
          isClubManager(get(/databases/$(database)/documents/teams/$(resource.data.teamId)).data.clubId))
      );
      allow create: if isSignedIn() &&
        request.resource.data.personUid == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        // Quien pide acceso no se puede asignar el nivel Pro: lo decide el
        // gestor al aprobar (update). Sin campo o 'standard' = Estándar.
        (!('tier' in request.resource.data) || request.resource.data.tier == 'standard');
      allow update: if isSignedIn() &&
        exists(/databases/$(database)/documents/teams/$(resource.data.teamId)) &&
        (isSystemAdmin() ||
          isClubManager(get(/databases/$(database)/documents/teams/$(resource.data.teamId)).data.clubId));
      allow delete: if isSignedIn() && resource.data.personUid == request.auth.uid;
    }

    // Plantilla: pertenece a un equipo concreto.
    match /players/{playerId} {
      allow read: if canViewTeamData(resource.data.clubId, resource.data.teamId);
      allow create: if canManageTeamCapability(request.resource.data.clubId, request.resource.data.teamId, 'manageRoster');
      allow update, delete: if canManageTeamCapability(resource.data.clubId, resource.data.teamId, 'manageRoster');
    }

    // Asistencia a entrenamientos (2026-09-19): un documento por sesión con
    // el mapa de asistencia dentro. Solo cuerpo técnico con la capacidad
    // "coachPanel" (o gestor de club / admin) — ni siquiera el resto del
    // staff activo, y nunca un Seguidor o tutor: es información de menores
    // que el propio entrenador decide no compartir.
    match /trainings/{trainingId} {
      allow read, delete: if canManageTeamCapability(resource.data.clubId, resource.data.teamId, 'coachPanel');
      allow create: if canManageTeamCapability(request.resource.data.clubId, request.resource.data.teamId, 'coachPanel');
      allow update: if canManageTeamCapability(resource.data.clubId, resource.data.teamId, 'coachPanel') &&
        request.resource.data.clubId == resource.data.clubId &&
        request.resource.data.teamId == resource.data.teamId;
    }

    // Partido: la convocatoria la gestiona quien puede gestionar la
    // plantilla del equipo; la consola en vivo, quien tenga esa capacidad.
    match /matches/{matchId} {
      allow read: if canViewTeamData(resource.data.clubId, resource.data.teamId);
      allow create: if canManageTeamCapability(request.resource.data.clubId, request.resource.data.teamId, 'manageRoster');
      allow update: if canManageTeamCapability(resource.data.clubId, resource.data.teamId, 'benchConsole');
      allow delete: if canManageTeamCapability(resource.data.clubId, resource.data.teamId, 'manageRoster');

      match /players/{playerId} {
        allow read: if canViewTeamData(
          get(/databases/$(database)/documents/matches/$(matchId)).data.clubId,
          get(/databases/$(database)/documents/matches/$(matchId)).data.teamId
        );
        allow write: if canManageTeamCapability(
          get(/databases/$(database)/documents/matches/$(matchId)).data.clubId,
          get(/databases/$(database)/documents/matches/$(matchId)).data.teamId,
          'benchConsole'
        );
      }

      match /events/{eventId} {
        allow read: if canViewTeamData(
          get(/databases/$(database)/documents/matches/$(matchId)).data.clubId,
          get(/databases/$(database)/documents/matches/$(matchId)).data.teamId
        );
        allow write: if canManageTeamCapability(
          get(/databases/$(database)/documents/matches/$(matchId)).data.clubId,
          get(/databases/$(database)/documents/matches/$(matchId)).data.teamId,
          'benchConsole'
        );
      }

      // Detalle de cada gol rival: dorsal, minuto y zonas (opcional).
      match /rivalGoals/{rivalGoalId} {
        allow read: if canViewTeamData(
          get(/databases/$(database)/documents/matches/$(matchId)).data.clubId,
          get(/databases/$(database)/documents/matches/$(matchId)).data.teamId
        );
        allow write: if canManageTeamCapability(
          get(/databases/$(database)/documents/matches/$(matchId)).data.clubId,
          get(/databases/$(database)/documents/matches/$(matchId)).data.teamId,
          'benchConsole'
        );
      }

      // Detalle de cada fallo rival (tiró fuera, sin parada nuestra):
      // dorsal, minuto y zonas (opcional).
      match /rivalMisses/{rivalMissId} {
        allow read: if canViewTeamData(
          get(/databases/$(database)/documents/matches/$(matchId)).data.clubId,
          get(/databases/$(database)/documents/matches/$(matchId)).data.teamId
        );
        allow write: if canManageTeamCapability(
          get(/databases/$(database)/documents/matches/$(matchId)).data.clubId,
          get(/databases/$(database)/documents/matches/$(matchId)).data.teamId,
          'benchConsole'
        );
      }

      // Detalle de cada gol/fallo propio: jugador, minuto y zonas (opcional).
      match /shotEvents/{shotEventId} {
        allow read: if canViewTeamData(
          get(/databases/$(database)/documents/matches/$(matchId)).data.clubId,
          get(/databases/$(database)/documents/matches/$(matchId)).data.teamId
        );
        allow write: if canManageTeamCapability(
          get(/databases/$(database)/documents/matches/$(matchId)).data.clubId,
          get(/databases/$(database)/documents/matches/$(matchId)).data.teamId,
          'benchConsole'
        );
      }

      // Detalle de cada parada del portero: jugador, minuto y zona (opcional).
      match /saveEvents/{saveEventId} {
        allow read: if canViewTeamData(
          get(/databases/$(database)/documents/matches/$(matchId)).data.clubId,
          get(/databases/$(database)/documents/matches/$(matchId)).data.teamId
        );
        allow write: if canManageTeamCapability(
          get(/databases/$(database)/documents/matches/$(matchId)).data.clubId,
          get(/databases/$(database)/documents/matches/$(matchId)).data.teamId,
          'benchConsole'
        );
      }

      // Exclusión rival: solo dorsal y minuto, sin zonas.
      match /rivalExclusions/{rivalExclusionId} {
        allow read: if canViewTeamData(
          get(/databases/$(database)/documents/matches/$(matchId)).data.clubId,
          get(/databases/$(database)/documents/matches/$(matchId)).data.teamId
        );
        allow write: if canManageTeamCapability(
          get(/databases/$(database)/documents/matches/$(matchId)).data.clubId,
          get(/databases/$(database)/documents/matches/$(matchId)).data.teamId,
          'benchConsole'
        );
      }

      // Recuperación propia con minuto (antes solo un contador sin momento).
      match /recoveryEvents/{recoveryEventId} {
        allow read: if canViewTeamData(
          get(/databases/$(database)/documents/matches/$(matchId)).data.clubId,
          get(/databases/$(database)/documents/matches/$(matchId)).data.teamId
        );
        allow write: if canManageTeamCapability(
          get(/databases/$(database)/documents/matches/$(matchId)).data.clubId,
          get(/databases/$(database)/documents/matches/$(matchId)).data.teamId,
          'benchConsole'
        );
      }

      // Robos del rival, pérdidas (de cualquier equipo) y pasivos (2026-09-21): un
      // documento por acción, con {kind: 'steal'|'turnover'|'passive', team}.
      // Mismos permisos que recoveryEvents.
      match /teamActionEvents/{teamActionEventId} {
        allow read: if canViewTeamData(
          get(/databases/$(database)/documents/matches/$(matchId)).data.clubId,
          get(/databases/$(database)/documents/matches/$(matchId)).data.teamId
        );
        allow write: if canManageTeamCapability(
          get(/databases/$(database)/documents/matches/$(matchId)).data.clubId,
          get(/databases/$(database)/documents/matches/$(matchId)).data.teamId,
          'benchConsole'
        );
      }

      // Asistencia propia (2026-09-21): opcional, enlazada a un gol propio
      // (shotEventId). Mismos permisos que recoveryEvents.
      match /assistEvents/{assistEventId} {
        allow read: if canViewTeamData(
          get(/databases/$(database)/documents/matches/$(matchId)).data.clubId,
          get(/databases/$(database)/documents/matches/$(matchId)).data.teamId
        );
        allow write: if canManageTeamCapability(
          get(/databases/$(database)/documents/matches/$(matchId)).data.clubId,
          get(/databases/$(database)/documents/matches/$(matchId)).data.teamId,
          'benchConsole'
        );
      }

      // Exclusión propia con minuto (disqualified=true en la 3ª = expulsión).
      match /exclusionEvents/{exclusionEventId} {
        allow read: if canViewTeamData(
          get(/databases/$(database)/documents/matches/$(matchId)).data.clubId,
          get(/databases/$(database)/documents/matches/$(matchId)).data.teamId
        );
        allow write: if canManageTeamCapability(
          get(/databases/$(database)/documents/matches/$(matchId)).data.clubId,
          get(/databases/$(database)/documents/matches/$(matchId)).data.teamId,
          'benchConsole'
        );
      }

      // 7 metros provocado por el rival: solo dorsal y minuto, sin cuenta
      // atrás (no es una sanción temporal como una exclusión).
      match /rivalSevenMeters/{rivalSevenMeterId} {
        allow read: if canViewTeamData(
          get(/databases/$(database)/documents/matches/$(matchId)).data.clubId,
          get(/databases/$(database)/documents/matches/$(matchId)).data.teamId
        );
        allow write: if canManageTeamCapability(
          get(/databases/$(database)/documents/matches/$(matchId)).data.clubId,
          get(/databases/$(database)/documents/matches/$(matchId)).data.teamId,
          'benchConsole'
        );
      }

      // Tarjeta amarilla propia (2026-09-16): solo dorsal/jugador y minuto,
      // sin cuenta atrás — es una amonestación, no una sanción temporal.
      // Como mucho un documento por jugador y partido (se aplica en el
      // cliente, no aquí).
      match /yellowCardEvents/{yellowCardEventId} {
        allow read: if canViewTeamData(
          get(/databases/$(database)/documents/matches/$(matchId)).data.clubId,
          get(/databases/$(database)/documents/matches/$(matchId)).data.teamId
        );
        allow write: if canManageTeamCapability(
          get(/databases/$(database)/documents/matches/$(matchId)).data.clubId,
          get(/databases/$(database)/documents/matches/$(matchId)).data.teamId,
          'benchConsole'
        );
      }

      // Tarjeta amarilla rival — mismo criterio que rivalSevenMeters.
      match /rivalYellowCards/{rivalYellowCardId} {
        allow read: if canViewTeamData(
          get(/databases/$(database)/documents/matches/$(matchId)).data.clubId,
          get(/databases/$(database)/documents/matches/$(matchId)).data.teamId
        );
        allow write: if canManageTeamCapability(
          get(/databases/$(database)/documents/matches/$(matchId)).data.clubId,
          get(/databases/$(database)/documents/matches/$(matchId)).data.teamId,
          'benchConsole'
        );
      }
    }
  }
}
